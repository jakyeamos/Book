{
  "version": 1,
  "testCommand": "pnpm test",
  "coverageAdapters": [
    {
      "name": "book-coverage-marker",
      "command": "node scripts/pre-cr-coverage.cjs",
      "coveragePath": ".pre-cr/coverage.lcov",
      "coverageFormat": "lcov"
    }
  ],
  "threshold": 80,
  "checks": {
    "coverage": true,
    "security": true,
    "checklist": true
  },
  "coveragePaths": [
    "coverage/lcov.info",
    "coverage/coverage-final.json",
    ".nyc_output/coverage.json",
    "coverage.lcov",
    "lcov.info",
    "coverage.out"
  ],
  "coverageFormat": "auto"
}
